# Cole aqui as duas chaves do seu projeto no Supabase.
# Onde achar: painel do Supabase > Project Settings > API
#   NEXT_PUBLIC_SUPABASE_URL      = campo "Project URL"
#   NEXT_PUBLIC_SUPABASE_ANON_KEY = chave "anon public" (nos projetos novos aparece como "publishable key")
# Estas duas chaves são públicas por natureza: quem protege os dados é o RLS do banco.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional. Com esta chave, quem lê as conversas dos canais e transforma o que ficou
# combinado em tarefa é o modelo da Anthropic, em vez das regras embutidas no app.
# Onde achar: console.anthropic.com > API Keys. Ela fica só no servidor.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# Obrigatória para os Conectores funcionarem. É ela que cifra a chave de API que cada
# cliente cola, e sem ela o app se recusa a guardar chave (em vez de guardar aberta).
# Gere um texto longo e aleatório uma única vez, por exemplo:
#   openssl rand -base64 48
# ATENÇÃO: trocar este valor depois cega todas as chaves já guardadas, e cada pessoa
# teria que colar a dela de novo. Guarde em lugar seguro.
# TRACK_SEGREDO=
