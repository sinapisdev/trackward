# ==========================================================================
# TrackWard
# Copie para .env.local e preencha. Sem as duas primeiras, o app roda inteiro
# no navegador, no modo demonstração, com a empresa de exemplo.
# ==========================================================================

# ---- Supabase -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# A chave de serviço abre o banco INTEIRO, sem RLS. Ela é usada num lugar só,
# em /api/avisar, porque quem chama aquilo é um relógio e relógio não tem sessão.
# NUNCA prefixe com NEXT_PUBLIC_: no navegador, seria entregar tudo.
SUPABASE_SERVICE_ROLE=

# ---- Segredos do servidor -------------------------------------------------
# Abre a cifra das chaves de conector guardadas no banco. Trocar esta variável
# faz as chaves já guardadas pararem de abrir.
TRACK_SEGREDO=

# Quem pode chamar /api/avisar. Qualquer texto longo e aleatório serve.
TRACK_AVISOS_SEGREDO=

# ---- Avisos por push ------------------------------------------------------
# Gere o par uma vez:  npx web-push generate-vapid-keys
# A pública vai nas duas variáveis, com o mesmo valor: uma para o servidor
# assinar, outra para o navegador assinar o aparelho.
VAPID_CHAVE_PUBLICA=
NEXT_PUBLIC_VAPID_CHAVE=
VAPID_CHAVE_PRIVADA=
# Por onde o serviço de push fala com você se algo der errado.
VAPID_CONTATO=mailto:avisos@trackward.com.br

# O endereço público do app, para o aviso levar a pessoa ao lugar certo.
NEXT_PUBLIC_URL=https://app.trackward.com.br

# ---- Leitura da conversa (opcional) ---------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
